{
  "name": "DerivX (Python 3.11)",
  // Same Python as the Docker image and CI's reference job.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/derivx/ui/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  // Runtime, test, lint and notebook dependencies from pyproject.toml.
  "updateContentCommand": "python -m pip install --user --upgrade pip && python -m pip install --user -e '.[dev,notebooks]'",
  // Streamlit runs with its default XSRF and CORS protection (.streamlit/config.toml).
  "postAttachCommand": {
    "server": "streamlit run src/derivx/ui/streamlit_app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      // A browser tab, not the editor's preview pane: the embedded preview can
      // block the cookie that Streamlit's XSRF check needs for file uploads.
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [
    8501
  ]
}
